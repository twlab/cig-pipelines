{
  "genome_wgs.sample": "{{SAMPLE}}",
  "genome_wgs.input_files": ["{{INPUT_FILES}}"],
  "genome_wgs.idx": "{{IDX}}",
  "genome_wgs.trimmer": {
    "run": false,
    "params": "",
    "docker": "mgibio/fastp:v0.23.4-noble",
    "cpu": 2,
    "memory": 16
  },
  "genome_wgs.fastqc": {
    "run": false,
    "params": "",
    "docker": "mgibio/fastqc:v0.12.1-noble",
    "cpu": 2,
    "memory": 16
  },
  "genome_wgs.left_align_bam": {
    "run": false,
    "params": "",
    "docker": "mgibio/freebayes:1.3.6-focal",
    "cpu": 1,
    "memory": 4
  },
  "genome_wgs.realign_bam": {
    "run": false,
    "params": "160",
    "docker": "mgibio/realign-bam:latest",
    "cpu": 4,
    "memory": 24
  },
  "genome_wgs.markdup_bam": {
    "run": false,
    "params": "--SORTING_COLLECTION_SIZE_RATIO .15",
    "docker": "mgibio/picard:v3.3.0-noble",
    "cpu": 4,
    "memory": 20
  },
  "genome_wgs.bwa_docker": "mgibio/bwa:0.7.17",
  "genome_wgs.bwa_cpu": 8,
  "genome_wgs.bwa_memory": 48, 
  "genome_wgs.deepvariant_docker": "google/deepvariant:1.8.0",
  "genome_wgs.deepvariant_cpu": 20,
  "genome_wgs.deepvariant_memory": 96,
  "genome_wgs.samtools_docker": "mgibio/samtools:v1.21-noble",
  "genome_wgs.samtools_cpu": 1,
  "genome_wgs.samtools_memory": 4, 
  "genome_wgs.utils_docker": "mgibio/linux-tk:latest",
  "genome_wgs.utils_cpu": 1,
  "genome_wgs.utils_memory": 4 
}
